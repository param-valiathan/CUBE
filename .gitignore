# Allowlist: only code, the README, the guide and logos are published.
*
!.gitignore
!README.md
!*.py
!*.bat
!*.ps1
!.gitattributes
!env/
!env/environment.yml
!env/environment-cpu.yml
!env/requirements-lock.txt
!env/requirements-lock-cpu.txt
!assets/
!assets/CUBE.ico
!assets/CUBE_logo.png
!assets/CUBE_logo dark theme.png
!guided/
!guided/*.py
!docs/
!docs/CUBE_Guide.md
!docs/CUBE_Guide.docx
!docs/charuco_board_v2_print.png
__pycache__/
